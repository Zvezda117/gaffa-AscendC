#include "kernel_operator.h"

#include <acl/acl.h>
#include <cstdint>

namespace {
constexpr std::uint32_t kOutputTileElements = 64;

__aicore__ inline void CopyTailToGlobal(
    AscendC::GlobalTensor<float>& dst, std::uint64_t dst_offset,
    const AscendC::LocalTensor<float>& src, std::uint32_t valid_elements) {
  AscendC::DataCopyExtParams params{1,
      valid_elements * static_cast<std::uint32_t>(sizeof(float)), 0, 0, 0};
  AscendC::DataCopyPad(dst[dst_offset], src, params);
}

class WeightedDownsampleKernel {
 public:
  __aicore__ inline void Init(GM_ADDR input, GM_ADDR first_input,
                              GM_ADDR last_input, GM_ADDR first_weight,
                              GM_ADDR last_weight, GM_ADDR output,
                              std::uint32_t nseries,
                              std::uint32_t input_nsamples,
                              std::uint32_t output_nsamples) {
    nseries_ = nseries; input_nsamples_ = input_nsamples;
    output_nsamples_ = output_nsamples;
    input_gm_.SetGlobalBuffer((__gm__ float*)input,
        static_cast<std::uint64_t>(nseries) * input_nsamples);
    first_input_gm_.SetGlobalBuffer((__gm__ std::uint32_t*)first_input, output_nsamples);
    last_input_gm_.SetGlobalBuffer((__gm__ std::uint32_t*)last_input, output_nsamples);
    first_weight_gm_.SetGlobalBuffer((__gm__ float*)first_weight, output_nsamples);
    last_weight_gm_.SetGlobalBuffer((__gm__ float*)last_weight, output_nsamples);
    output_gm_.SetGlobalBuffer((__gm__ float*)output,
        static_cast<std::uint64_t>(nseries) * output_nsamples);
    pipe_.InitBuffer(output_queue_, 1, kOutputTileElements * sizeof(float));
  }
  __aicore__ inline void Process() {
    const std::uint32_t block_idx = AscendC::GetBlockIdx();
    const std::uint32_t block_num = AscendC::GetBlockNum();
    for (std::uint32_t series = block_idx; series < nseries_; series += block_num)
      ProcessSeries(series);
  }
 private:
  __aicore__ inline void ProcessSeries(std::uint32_t series) {
    const std::uint64_t input_base = static_cast<std::uint64_t>(series) * input_nsamples_;
    const std::uint64_t output_base = static_cast<std::uint64_t>(series) * output_nsamples_;
    for (std::uint32_t tile_begin = 0; tile_begin < output_nsamples_;
         tile_begin += kOutputTileElements) {
      const std::uint32_t remaining = output_nsamples_ - tile_begin;
      const std::uint32_t valid = remaining < kOutputTileElements ? remaining : kOutputTileElements;
      auto output_local = output_queue_.AllocTensor<float>();
      for (std::uint32_t local_index = 0; local_index < valid; ++local_index) {
        const std::uint32_t output_index = tile_begin + local_index;
        const std::uint32_t first = first_input_gm_.GetValue(output_index);
        const std::uint32_t last = last_input_gm_.GetValue(output_index);
        const float first_weight = first_weight_gm_.GetValue(output_index);
        const float last_weight = last_weight_gm_.GetValue(output_index);
        float sum = first_weight * input_gm_.GetValue(input_base + first);
        for (std::uint32_t input_index = first + 1; input_index < last; ++input_index)
          sum += input_gm_.GetValue(input_base + input_index);
        sum += last_weight * input_gm_.GetValue(input_base + last);
        output_local(local_index) = sum;
      }
      output_queue_.EnQue(output_local);
      auto ready = output_queue_.DeQue<float>();
      CopyTailToGlobal(output_gm_, output_base + tile_begin, ready, valid);
      output_queue_.FreeTensor(ready);
    }
  }
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> output_queue_;
  AscendC::GlobalTensor<float> input_gm_;
  AscendC::GlobalTensor<std::uint32_t> first_input_gm_, last_input_gm_;
  AscendC::GlobalTensor<float> first_weight_gm_, last_weight_gm_, output_gm_;
  std::uint32_t nseries_ = 0, input_nsamples_ = 0, output_nsamples_ = 0;
};

class Uint32ToFloatKernel {
 public:
  __aicore__ inline void Init(GM_ADDR input, GM_ADDR output, std::uint32_t count) {
    count_ = count;
    input_gm_.SetGlobalBuffer((__gm__ std::uint32_t*)input, count);
    output_gm_.SetGlobalBuffer((__gm__ float*)output, count);
    pipe_.InitBuffer(output_queue_, 1, kOutputTileElements * sizeof(float));
  }
  __aicore__ inline void Process() {
    const std::uint32_t block_idx = AscendC::GetBlockIdx();
    const std::uint32_t block_num = AscendC::GetBlockNum();
    const std::uint32_t stride = block_num * kOutputTileElements;
    for (std::uint32_t tile_begin = block_idx * kOutputTileElements;
         tile_begin < count_; tile_begin += stride) {
      const std::uint32_t remaining = count_ - tile_begin;
      const std::uint32_t valid = remaining < kOutputTileElements ? remaining : kOutputTileElements;
      auto output_local = output_queue_.AllocTensor<float>();
      for (std::uint32_t local_index = 0; local_index < valid; ++local_index)
        output_local(local_index) = static_cast<float>(input_gm_.GetValue(tile_begin + local_index));
      output_queue_.EnQue(output_local);
      auto ready = output_queue_.DeQue<float>();
      CopyTailToGlobal(output_gm_, tile_begin, ready, valid);
      output_queue_.FreeTensor(ready);
    }
  }
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> output_queue_;
  AscendC::GlobalTensor<std::uint32_t> input_gm_;
  AscendC::GlobalTensor<float> output_gm_;
  std::uint32_t count_ = 0;
};
}  // namespace

extern "C" __global__ __aicore__ void gaffa_downsample_weighted_sum_kernel(
    GM_ADDR input, GM_ADDR first_input, GM_ADDR last_input,
    GM_ADDR first_weight, GM_ADDR last_weight, GM_ADDR output,
    std::uint32_t nseries, std::uint32_t input_nsamples,
    std::uint32_t output_nsamples) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  WeightedDownsampleKernel kernel;
  kernel.Init(input, first_input, last_input, first_weight, last_weight, output,
              nseries, input_nsamples, output_nsamples);
  kernel.Process();
}

extern "C" __global__ __aicore__ void gaffa_convert_uint32_to_float_kernel(
    GM_ADDR input, GM_ADDR output, std::uint32_t count) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  Uint32ToFloatKernel kernel;
  kernel.Init(input, output, count);
  kernel.Process();
}

extern "C" void gaffa_launch_downsample_weighted_sum_ascend(
    void* input, void* first_input, void* last_input, void* first_weight,
    void* last_weight, void* output, std::uint32_t nseries,
    std::uint32_t input_nsamples, std::uint32_t output_nsamples,
    std::uint32_t block_dim, void* stream) {
  gaffa_downsample_weighted_sum_kernel<<<block_dim, nullptr,
      reinterpret_cast<aclrtStream>(stream)>>>(
      reinterpret_cast<GM_ADDR>(input), reinterpret_cast<GM_ADDR>(first_input),
      reinterpret_cast<GM_ADDR>(last_input), reinterpret_cast<GM_ADDR>(first_weight),
      reinterpret_cast<GM_ADDR>(last_weight), reinterpret_cast<GM_ADDR>(output),
      nseries, input_nsamples, output_nsamples);
}

extern "C" void gaffa_launch_convert_uint32_to_float_ascend(
    void* input, void* output, std::uint32_t count, std::uint32_t block_dim,
    void* stream) {
  gaffa_convert_uint32_to_float_kernel<<<block_dim, nullptr,
      reinterpret_cast<aclrtStream>(stream)>>>(
      reinterpret_cast<GM_ADDR>(input), reinterpret_cast<GM_ADDR>(output), count);
}
