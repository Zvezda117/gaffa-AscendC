#include "kernel_operator.h"

#include <acl/acl.h>
#include <cstdint>

namespace {
constexpr std::uint32_t kTileElements = 256;

class VectorAddKernel {
 public:
  __aicore__ inline VectorAddKernel() = default;
  __aicore__ inline void Init(GM_ADDR lhs, GM_ADDR rhs, GM_ADDR out,
                              std::uint32_t total_elements) {
    block_elements_ = total_elements / AscendC::GetBlockNum();
    tile_count_ = block_elements_ / kTileElements;
    const std::uint32_t block_offset = AscendC::GetBlockIdx() * block_elements_;
    lhs_gm_.SetGlobalBuffer((__gm__ float*)lhs + block_offset, block_elements_);
    rhs_gm_.SetGlobalBuffer((__gm__ float*)rhs + block_offset, block_elements_);
    out_gm_.SetGlobalBuffer((__gm__ float*)out + block_offset, block_elements_);
    pipe_.InitBuffer(lhs_queue_, 1, kTileElements * sizeof(float));
    pipe_.InitBuffer(rhs_queue_, 1, kTileElements * sizeof(float));
    pipe_.InitBuffer(out_queue_, 1, kTileElements * sizeof(float));
  }
  __aicore__ inline void Process() {
    for (std::uint32_t tile = 0; tile < tile_count_; ++tile) {
      CopyIn(tile); Compute(); CopyOut(tile);
    }
  }
 private:
  __aicore__ inline void CopyIn(std::uint32_t tile) {
    auto lhs_local = lhs_queue_.AllocTensor<float>();
    auto rhs_local = rhs_queue_.AllocTensor<float>();
    const std::uint32_t offset = tile * kTileElements;
    AscendC::DataCopy(lhs_local, lhs_gm_[offset], kTileElements);
    AscendC::DataCopy(rhs_local, rhs_gm_[offset], kTileElements);
    lhs_queue_.EnQue(lhs_local); rhs_queue_.EnQue(rhs_local);
  }
  __aicore__ inline void Compute() {
    auto lhs_local = lhs_queue_.DeQue<float>();
    auto rhs_local = rhs_queue_.DeQue<float>();
    auto out_local = out_queue_.AllocTensor<float>();
    AscendC::Add(out_local, lhs_local, rhs_local, kTileElements);
    out_queue_.EnQue(out_local);
    lhs_queue_.FreeTensor(lhs_local); rhs_queue_.FreeTensor(rhs_local);
  }
  __aicore__ inline void CopyOut(std::uint32_t tile) {
    auto out_local = out_queue_.DeQue<float>();
    AscendC::DataCopy(out_gm_[tile * kTileElements], out_local, kTileElements);
    out_queue_.FreeTensor(out_local);
  }
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECIN, 1> lhs_queue_;
  AscendC::TQue<AscendC::TPosition::VECIN, 1> rhs_queue_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> out_queue_;
  AscendC::GlobalTensor<float> lhs_gm_, rhs_gm_, out_gm_;
  std::uint32_t block_elements_ = 0, tile_count_ = 0;
};
}  // namespace

extern "C" __global__ __aicore__ void gaffa_vector_add_kernel(
    GM_ADDR lhs, GM_ADDR rhs, GM_ADDR out, std::uint32_t total_elements) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  VectorAddKernel kernel;
  kernel.Init(lhs, rhs, out, total_elements);
  kernel.Process();
}

extern "C" void gaffa_launch_vector_add_ascend(
    void* lhs, void* rhs, void* out, std::uint32_t total_elements,
    std::uint32_t block_dim, void* stream) {
  gaffa_vector_add_kernel<<<block_dim, nullptr,
                            reinterpret_cast<aclrtStream>(stream)>>>(
      reinterpret_cast<GM_ADDR>(lhs), reinterpret_cast<GM_ADDR>(rhs),
      reinterpret_cast<GM_ADDR>(out), total_elements);
}
