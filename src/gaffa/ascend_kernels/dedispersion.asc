#include "kernel_operator.h"

#include <acl/acl.h>
#include <cstdint>

namespace {
constexpr std::uint32_t kTileElements = 64;

template <typename T>
__aicore__ inline void CopyTailToGlobal(
    AscendC::GlobalTensor<T>& dst, std::uint64_t dst_offset,
    const AscendC::LocalTensor<T>& src, std::uint32_t valid_elements) {
  AscendC::DataCopyExtParams params{
      1,
      valid_elements * static_cast<std::uint32_t>(sizeof(T)),
      0,
      0,
      0,
  };
  AscendC::DataCopyPad(dst[dst_offset], src, params);
}

template <typename InT, typename OutT>
class DirectDedispersionKernel {
 public:
  __aicore__ inline void Init(GM_ADDR input, GM_ADDR delays, GM_ADDR output,
                              std::uint32_t ndm,
                              std::uint32_t input_nsamples,
                              std::uint32_t input_nchans,
                              std::uint32_t channel_count,
                              std::uint32_t chan_begin,
                              std::uint32_t output_nsamples) {
    ndm_ = ndm;
    input_nsamples_ = input_nsamples;
    input_nchans_ = input_nchans;
    channel_count_ = channel_count;
    chan_begin_ = chan_begin;
    output_nsamples_ = output_nsamples;
    output_count_ = static_cast<std::uint64_t>(ndm) * output_nsamples;

    input_gm_.SetGlobalBuffer(
        (__gm__ InT*)input,
        static_cast<std::uint64_t>(input_nsamples) * input_nchans);
    delays_gm_.SetGlobalBuffer(
        (__gm__ std::int32_t*)delays,
        static_cast<std::uint64_t>(ndm) * channel_count);
    output_gm_.SetGlobalBuffer((__gm__ OutT*)output, output_count_);
    pipe_.InitBuffer(output_queue_, 1, kTileElements * sizeof(OutT));
  }

  __aicore__ inline void Process() {
    const std::uint32_t block = AscendC::GetBlockIdx();
    const std::uint32_t blocks = AscendC::GetBlockNum();
    const std::uint64_t stride =
        static_cast<std::uint64_t>(blocks) * kTileElements;
    for (std::uint64_t tile =
             static_cast<std::uint64_t>(block) * kTileElements;
         tile < output_count_; tile += stride) {
      const std::uint64_t remaining = output_count_ - tile;
      const std::uint32_t valid =
          remaining < kTileElements ? static_cast<std::uint32_t>(remaining)
                                    : kTileElements;
      auto local = output_queue_.AllocTensor<OutT>();
      for (std::uint32_t k = 0; k < valid; ++k) {
        const std::uint64_t flat = tile + k;
        const std::uint32_t dm =
            static_cast<std::uint32_t>(flat / output_nsamples_);
        const std::uint32_t time =
            static_cast<std::uint32_t>(flat % output_nsamples_);
        OutT sum = static_cast<OutT>(0);
        const std::uint64_t delay_base =
            static_cast<std::uint64_t>(dm) * channel_count_;
        for (std::uint32_t c = 0; c < channel_count_; ++c) {
          const std::int32_t delay = delays_gm_.GetValue(delay_base + c);
          const std::uint32_t shifted =
              time + static_cast<std::uint32_t>(delay);
          const std::uint64_t input_index =
              static_cast<std::uint64_t>(shifted) * input_nchans_ +
              chan_begin_ + c;
          sum += static_cast<OutT>(input_gm_.GetValue(input_index));
        }
        local(k) = sum;
      }
      output_queue_.EnQue(local);
      auto ready = output_queue_.DeQue<OutT>();
      CopyTailToGlobal(output_gm_, tile, ready, valid);
      output_queue_.FreeTensor(ready);
    }
  }

 private:
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> output_queue_;
  AscendC::GlobalTensor<InT> input_gm_;
  AscendC::GlobalTensor<std::int32_t> delays_gm_;
  AscendC::GlobalTensor<OutT> output_gm_;
  std::uint32_t ndm_ = 0;
  std::uint32_t input_nsamples_ = 0;
  std::uint32_t input_nchans_ = 0;
  std::uint32_t channel_count_ = 0;
  std::uint32_t chan_begin_ = 0;
  std::uint32_t output_nsamples_ = 0;
  std::uint64_t output_count_ = 0;
};

template <typename T>
class SpectrumDedispersionKernel {
 public:
  __aicore__ inline void Init(GM_ADDR input, GM_ADDR delays, GM_ADDR output,
                              std::uint32_t input_nsamples,
                              std::uint32_t input_nchans,
                              std::uint32_t channel_count,
                              std::uint32_t chan_begin,
                              std::uint32_t output_nsamples) {
    input_nsamples_ = input_nsamples;
    input_nchans_ = input_nchans;
    channel_count_ = channel_count;
    chan_begin_ = chan_begin;
    output_nsamples_ = output_nsamples;
    output_count_ =
        static_cast<std::uint64_t>(output_nsamples) * channel_count;
    input_gm_.SetGlobalBuffer(
        (__gm__ T*)input,
        static_cast<std::uint64_t>(input_nsamples) * input_nchans);
    delays_gm_.SetGlobalBuffer((__gm__ std::int32_t*)delays, channel_count);
    output_gm_.SetGlobalBuffer((__gm__ T*)output, output_count_);
    pipe_.InitBuffer(output_queue_, 1, kTileElements * sizeof(T));
  }

  __aicore__ inline void Process() {
    const std::uint32_t block = AscendC::GetBlockIdx();
    const std::uint32_t blocks = AscendC::GetBlockNum();
    const std::uint64_t stride =
        static_cast<std::uint64_t>(blocks) * kTileElements;
    for (std::uint64_t tile =
             static_cast<std::uint64_t>(block) * kTileElements;
         tile < output_count_; tile += stride) {
      const std::uint64_t remaining = output_count_ - tile;
      const std::uint32_t valid =
          remaining < kTileElements ? static_cast<std::uint32_t>(remaining)
                                    : kTileElements;
      auto local = output_queue_.AllocTensor<T>();
      for (std::uint32_t k = 0; k < valid; ++k) {
        const std::uint64_t flat = tile + k;
        const std::uint32_t time =
            static_cast<std::uint32_t>(flat / channel_count_);
        const std::uint32_t channel_offset =
            static_cast<std::uint32_t>(flat % channel_count_);
        const std::int32_t delay = delays_gm_.GetValue(channel_offset);
        const std::uint32_t shifted =
            time + static_cast<std::uint32_t>(delay);
        const std::uint64_t input_index =
            static_cast<std::uint64_t>(shifted) * input_nchans_ +
            chan_begin_ + channel_offset;
        local(k) = input_gm_.GetValue(input_index);
      }
      output_queue_.EnQue(local);
      auto ready = output_queue_.DeQue<T>();
      CopyTailToGlobal(output_gm_, tile, ready, valid);
      output_queue_.FreeTensor(ready);
    }
  }

 private:
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> output_queue_;
  AscendC::GlobalTensor<T> input_gm_;
  AscendC::GlobalTensor<std::int32_t> delays_gm_;
  AscendC::GlobalTensor<T> output_gm_;
  std::uint32_t input_nsamples_ = 0;
  std::uint32_t input_nchans_ = 0;
  std::uint32_t channel_count_ = 0;
  std::uint32_t chan_begin_ = 0;
  std::uint32_t output_nsamples_ = 0;
  std::uint64_t output_count_ = 0;
};
}  // namespace

#define DEFINE_DIRECT_KERNEL(kernel_name, InT, OutT) \
extern "C" __global__ __aicore__ void kernel_name( \
    GM_ADDR input, GM_ADDR delays, GM_ADDR output, std::uint32_t ndm, \
    std::uint32_t input_nsamples, std::uint32_t input_nchans, \
    std::uint32_t channel_count, std::uint32_t chan_begin, \
    std::uint32_t output_nsamples) { \
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY); \
  DirectDedispersionKernel<InT, OutT> kernel; \
  kernel.Init(input, delays, output, ndm, input_nsamples, input_nchans, \
              channel_count, chan_begin, output_nsamples); \
  kernel.Process(); \
}

DEFINE_DIRECT_KERNEL(gaffa_dedisperse_u8_kernel, std::uint8_t, std::uint32_t)
DEFINE_DIRECT_KERNEL(gaffa_dedisperse_u16_kernel, std::uint16_t, std::uint32_t)
DEFINE_DIRECT_KERNEL(gaffa_dedisperse_f32_kernel, float, float)

#define DEFINE_SPECTRUM_KERNEL(kernel_name, T) \
extern "C" __global__ __aicore__ void kernel_name( \
    GM_ADDR input, GM_ADDR delays, GM_ADDR output, \
    std::uint32_t input_nsamples, std::uint32_t input_nchans, \
    std::uint32_t channel_count, std::uint32_t chan_begin, \
    std::uint32_t output_nsamples) { \
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY); \
  SpectrumDedispersionKernel<T> kernel; \
  kernel.Init(input, delays, output, input_nsamples, input_nchans, \
              channel_count, chan_begin, output_nsamples); \
  kernel.Process(); \
}

DEFINE_SPECTRUM_KERNEL(gaffa_dedisperse_spectrum_u8_kernel, std::uint8_t)
DEFINE_SPECTRUM_KERNEL(gaffa_dedisperse_spectrum_u16_kernel, std::uint16_t)
DEFINE_SPECTRUM_KERNEL(gaffa_dedisperse_spectrum_f32_kernel, float)

#define DEFINE_DIRECT_LAUNCH(launch_name, kernel_name) \
extern "C" void launch_name( \
    void* input, void* delays, void* output, std::uint32_t ndm, \
    std::uint32_t input_nsamples, std::uint32_t input_nchans, \
    std::uint32_t channel_count, std::uint32_t chan_begin, \
    std::uint32_t output_nsamples, std::uint32_t block_dim, void* stream) { \
  kernel_name<<<block_dim, nullptr, reinterpret_cast<aclrtStream>(stream)>>>( \
      static_cast<std::uint8_t*>(input), static_cast<std::uint8_t*>(delays), \
      static_cast<std::uint8_t*>(output), ndm, input_nsamples, input_nchans, \
      channel_count, chan_begin, output_nsamples); \
}

DEFINE_DIRECT_LAUNCH(gaffa_launch_dedisperse_u8_ascend,
                     gaffa_dedisperse_u8_kernel)
DEFINE_DIRECT_LAUNCH(gaffa_launch_dedisperse_u16_ascend,
                     gaffa_dedisperse_u16_kernel)
DEFINE_DIRECT_LAUNCH(gaffa_launch_dedisperse_f32_ascend,
                     gaffa_dedisperse_f32_kernel)

#define DEFINE_SPECTRUM_LAUNCH(launch_name, kernel_name) \
extern "C" void launch_name( \
    void* input, void* delays, void* output, std::uint32_t input_nsamples, \
    std::uint32_t input_nchans, std::uint32_t channel_count, \
    std::uint32_t chan_begin, std::uint32_t output_nsamples, \
    std::uint32_t block_dim, void* stream) { \
  kernel_name<<<block_dim, nullptr, reinterpret_cast<aclrtStream>(stream)>>>( \
      static_cast<std::uint8_t*>(input), static_cast<std::uint8_t*>(delays), \
      static_cast<std::uint8_t*>(output), input_nsamples, input_nchans, \
      channel_count, chan_begin, output_nsamples); \
}

DEFINE_SPECTRUM_LAUNCH(gaffa_launch_dedisperse_spectrum_u8_ascend,
                       gaffa_dedisperse_spectrum_u8_kernel)
DEFINE_SPECTRUM_LAUNCH(gaffa_launch_dedisperse_spectrum_u16_ascend,
                       gaffa_dedisperse_spectrum_u16_kernel)
DEFINE_SPECTRUM_LAUNCH(gaffa_launch_dedisperse_spectrum_f32_ascend,
                       gaffa_dedisperse_spectrum_f32_kernel)
