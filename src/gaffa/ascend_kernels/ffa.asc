#include "kernel_operator.h"

#include <acl/acl.h>
#include <cstdint>

namespace {
constexpr std::uint32_t kTileElements = 64;
constexpr std::uint32_t kInputRole = 0;
constexpr std::uint32_t kScratchRole = 1;
constexpr std::uint32_t kOutputRole = 2;

__aicore__ inline float Uint32ToFloat(std::uint32_t value) {
  return static_cast<float>(static_cast<std::int64_t>(value));
}

__aicore__ inline std::uint32_t PositiveFloatToUint32(float value) {
  const std::int32_t signed_value =
      AscendC::ScalarCast<float, std::int32_t,
                          AscendC::RoundMode::CAST_TRUNC>(value);
  return static_cast<std::uint32_t>(signed_value);
}

template <typename T>
__aicore__ inline void CopyTailToGlobal(
    AscendC::GlobalTensor<T>& dst, std::uint64_t dst_offset,
    const AscendC::LocalTensor<T>& src, std::uint32_t valid_elements) {
  AscendC::DataCopyExtParams params{1,
      valid_elements * static_cast<std::uint32_t>(sizeof(T)), 0, 0, 0};
  AscendC::DataCopyPad(dst[dst_offset], src, params);
}

class FfaCopyLevelKernel {
 public:
  __aicore__ inline void Init(
      GM_ADDR input, GM_ADDR scratch, GM_ADDR output,
      std::uint32_t input_stride, std::uint32_t scratch_stride,
      std::uint32_t output_stride, std::uint32_t bins, GM_ADDR metadata,
      std::uint32_t op_count, std::uint32_t nseries,
      std::uint32_t max_rows) {
    input_stride_ = input_stride; scratch_stride_ = scratch_stride;
    output_stride_ = output_stride; bins_ = bins; op_count_ = op_count;
    nseries_ = nseries; max_rows_ = max_rows;
    task_count_ = static_cast<std::uint64_t>(nseries) * op_count * max_rows;
    input_gm_.SetGlobalBuffer((__gm__ float*)input,
        static_cast<std::uint64_t>(nseries) * input_stride);
    scratch_gm_.SetGlobalBuffer((__gm__ float*)scratch,
        static_cast<std::uint64_t>(nseries) * scratch_stride);
    output_gm_.SetGlobalBuffer((__gm__ float*)output,
        static_cast<std::uint64_t>(nseries) * output_stride);
    metadata_gm_.SetGlobalBuffer((__gm__ std::uint32_t*)metadata,
        static_cast<std::uint64_t>(op_count) * 5);
    pipe_.InitBuffer(queue_, 1, kTileElements * sizeof(float));
  }

  __aicore__ inline void Process() {
    const std::uint32_t block = AscendC::GetBlockIdx();
    const std::uint32_t blocks = AscendC::GetBlockNum();
    for (std::uint64_t task = block; task < task_count_; task += blocks) {
      const std::uint32_t row = static_cast<std::uint32_t>(task % max_rows_);
      const std::uint64_t op_series = task / max_rows_;
      const std::uint32_t op = static_cast<std::uint32_t>(op_series % op_count_);
      const std::uint32_t series = static_cast<std::uint32_t>(op_series / op_count_);
      const std::uint64_t base = static_cast<std::uint64_t>(op) * 5;
      const std::uint32_t input_role = metadata_gm_.GetValue(base + 0);
      const std::uint32_t output_role = metadata_gm_.GetValue(base + 1);
      const std::uint32_t input_begin = metadata_gm_.GetValue(base + 2);
      const std::uint32_t output_begin = metadata_gm_.GetValue(base + 3);
      const std::uint32_t rows = metadata_gm_.GetValue(base + 4);
      if (row >= rows) continue;
      const std::uint64_t source_row = RoleBase(input_role, series) +
          static_cast<std::uint64_t>(input_begin + row) * bins_;
      const std::uint64_t destination_row = RoleBase(output_role, series) +
          static_cast<std::uint64_t>(output_begin + row) * bins_;
      for (std::uint32_t tile = 0; tile < bins_; tile += kTileElements) {
        const std::uint32_t remaining = bins_ - tile;
        const std::uint32_t valid = remaining < kTileElements ? remaining : kTileElements;
        auto local = queue_.AllocTensor<float>();
        for (std::uint32_t k = 0; k < valid; ++k)
          local(k) = Read(input_role, source_row + tile + k);
        queue_.EnQue(local);
        auto ready = queue_.DeQue<float>();
        Write(output_role, destination_row + tile, ready, valid);
        queue_.FreeTensor(ready);
      }
    }
  }

 private:
  __aicore__ inline std::uint64_t RoleBase(std::uint32_t role,
                                           std::uint32_t series) const {
    const std::uint32_t stride = role == kInputRole ? input_stride_ :
        (role == kScratchRole ? scratch_stride_ : output_stride_);
    return static_cast<std::uint64_t>(series) * stride;
  }
  __aicore__ inline float Read(std::uint32_t role, std::uint64_t index) const {
    if (role == kInputRole) return input_gm_.GetValue(index);
    if (role == kScratchRole) return scratch_gm_.GetValue(index);
    return output_gm_.GetValue(index);
  }
  __aicore__ inline void Write(std::uint32_t role, std::uint64_t index,
                               const AscendC::LocalTensor<float>& local,
                               std::uint32_t valid) {
    if (role == kScratchRole) CopyTailToGlobal(scratch_gm_, index, local, valid);
    else CopyTailToGlobal(output_gm_, index, local, valid);
  }
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> queue_;
  AscendC::GlobalTensor<float> input_gm_, scratch_gm_, output_gm_;
  AscendC::GlobalTensor<std::uint32_t> metadata_gm_;
  std::uint32_t input_stride_ = 0, scratch_stride_ = 0, output_stride_ = 0;
  std::uint32_t bins_ = 0, op_count_ = 0, nseries_ = 0, max_rows_ = 0;
  std::uint64_t task_count_ = 0;
};

class FfaMergeLevelKernel {
 public:
  __aicore__ inline void Init(
      GM_ADDR input, GM_ADDR scratch, GM_ADDR output,
      std::uint32_t input_stride, std::uint32_t scratch_stride,
      std::uint32_t output_stride, std::uint32_t bins, GM_ADDR metadata,
      std::uint32_t op_count, std::uint32_t nseries,
      std::uint32_t max_output_rows) {
    input_stride_ = input_stride; scratch_stride_ = scratch_stride;
    output_stride_ = output_stride; bins_ = bins; op_count_ = op_count;
    nseries_ = nseries; max_output_rows_ = max_output_rows;
    task_count_ = static_cast<std::uint64_t>(nseries) * op_count * max_output_rows;
    input_gm_.SetGlobalBuffer((__gm__ float*)input,
        static_cast<std::uint64_t>(nseries) * input_stride);
    scratch_gm_.SetGlobalBuffer((__gm__ float*)scratch,
        static_cast<std::uint64_t>(nseries) * scratch_stride);
    output_gm_.SetGlobalBuffer((__gm__ float*)output,
        static_cast<std::uint64_t>(nseries) * output_stride);
    metadata_gm_.SetGlobalBuffer((__gm__ std::uint32_t*)metadata,
        static_cast<std::uint64_t>(op_count) * 9);
    pipe_.InitBuffer(queue_, 1, kTileElements * sizeof(float));
  }

  __aicore__ inline void Process() {
    const std::uint32_t block = AscendC::GetBlockIdx();
    const std::uint32_t blocks = AscendC::GetBlockNum();
    for (std::uint64_t task = block; task < task_count_; task += blocks) {
      const std::uint32_t shift = static_cast<std::uint32_t>(task % max_output_rows_);
      const std::uint64_t op_series = task / max_output_rows_;
      const std::uint32_t op = static_cast<std::uint32_t>(op_series % op_count_);
      const std::uint32_t series = static_cast<std::uint32_t>(op_series / op_count_);
      const std::uint64_t base = static_cast<std::uint64_t>(op) * 9;
      const std::uint32_t head_role = metadata_gm_.GetValue(base + 0);
      const std::uint32_t tail_role = metadata_gm_.GetValue(base + 1);
      const std::uint32_t output_role = metadata_gm_.GetValue(base + 2);
      const std::uint32_t head_begin = metadata_gm_.GetValue(base + 3);
      const std::uint32_t tail_begin = metadata_gm_.GetValue(base + 4);
      const std::uint32_t output_begin = metadata_gm_.GetValue(base + 5);
      const std::uint32_t head_rows = metadata_gm_.GetValue(base + 6);
      const std::uint32_t tail_rows = metadata_gm_.GetValue(base + 7);
      const std::uint32_t output_rows = metadata_gm_.GetValue(base + 8);
      if (shift >= output_rows) continue;
      const float head_scale = Uint32ToFloat(head_rows - 1) /
                               Uint32ToFloat(output_rows - 1);
      const float tail_scale = Uint32ToFloat(tail_rows - 1) /
                               Uint32ToFloat(output_rows - 1);
      const std::uint32_t head_shift = PositiveFloatToUint32(
          head_scale * Uint32ToFloat(shift) + 0.5F);
      const std::uint32_t tail_shift = PositiveFloatToUint32(
          tail_scale * Uint32ToFloat(shift) + 0.5F);
      const std::uint32_t compensation = shift - (head_shift + tail_shift);
      const std::uint32_t roll = (head_shift + compensation) % bins_;
      const std::uint64_t head_row = RoleBase(head_role, series) +
          static_cast<std::uint64_t>(head_begin + head_shift) * bins_;
      const std::uint64_t tail_row = RoleBase(tail_role, series) +
          static_cast<std::uint64_t>(tail_begin + tail_shift) * bins_;
      const std::uint64_t destination_row = RoleBase(output_role, series) +
          static_cast<std::uint64_t>(output_begin + shift) * bins_;
      for (std::uint32_t tile = 0; tile < bins_; tile += kTileElements) {
        const std::uint32_t remaining = bins_ - tile;
        const std::uint32_t valid = remaining < kTileElements ? remaining : kTileElements;
        auto local = queue_.AllocTensor<float>();
        for (std::uint32_t k = 0; k < valid; ++k) {
          const std::uint32_t bin = tile + k;
          const std::uint32_t tail_bin = bin + roll < bins_ ? bin + roll : bin + roll - bins_;
          local(k) = Read(head_role, head_row + bin) + Read(tail_role, tail_row + tail_bin);
        }
        queue_.EnQue(local);
        auto ready = queue_.DeQue<float>();
        Write(output_role, destination_row + tile, ready, valid);
        queue_.FreeTensor(ready);
      }
    }
  }

 private:
  __aicore__ inline std::uint64_t RoleBase(std::uint32_t role,
                                           std::uint32_t series) const {
    const std::uint32_t stride = role == kInputRole ? input_stride_ :
        (role == kScratchRole ? scratch_stride_ : output_stride_);
    return static_cast<std::uint64_t>(series) * stride;
  }
  __aicore__ inline float Read(std::uint32_t role, std::uint64_t index) const {
    if (role == kInputRole) return input_gm_.GetValue(index);
    if (role == kScratchRole) return scratch_gm_.GetValue(index);
    return output_gm_.GetValue(index);
  }
  __aicore__ inline void Write(std::uint32_t role, std::uint64_t index,
                               const AscendC::LocalTensor<float>& local,
                               std::uint32_t valid) {
    if (role == kScratchRole) CopyTailToGlobal(scratch_gm_, index, local, valid);
    else CopyTailToGlobal(output_gm_, index, local, valid);
  }
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> queue_;
  AscendC::GlobalTensor<float> input_gm_, scratch_gm_, output_gm_;
  AscendC::GlobalTensor<std::uint32_t> metadata_gm_;
  std::uint32_t input_stride_ = 0, scratch_stride_ = 0, output_stride_ = 0;
  std::uint32_t bins_ = 0, op_count_ = 0, nseries_ = 0, max_output_rows_ = 0;
  std::uint64_t task_count_ = 0;
};

class FfaDetectKernel {
 public:
  __aicore__ inline void Init(
      GM_ADDR transform, std::uint32_t transform_stride,
      std::uint32_t rows_eval, std::uint32_t bins, GM_ADDR widths,
      GM_ADDR heights, GM_ADDR baselines, std::uint32_t trial_count,
      float stdnoise, GM_ADDR phases, GM_ADDR snrs, std::uint32_t nseries) {
    transform_stride_ = transform_stride; rows_eval_ = rows_eval; bins_ = bins;
    trial_count_ = trial_count; stdnoise_ = stdnoise; nseries_ = nseries;
    task_count_ = static_cast<std::uint64_t>(nseries) * rows_eval * trial_count;
    transform_gm_.SetGlobalBuffer((__gm__ float*)transform,
        static_cast<std::uint64_t>(nseries) * transform_stride);
    widths_gm_.SetGlobalBuffer((__gm__ std::uint32_t*)widths, trial_count);
    heights_gm_.SetGlobalBuffer((__gm__ float*)heights, trial_count);
    baselines_gm_.SetGlobalBuffer((__gm__ float*)baselines, trial_count);
    phases_gm_.SetGlobalBuffer((__gm__ std::uint32_t*)phases, task_count_);
    snrs_gm_.SetGlobalBuffer((__gm__ float*)snrs, task_count_);
    pipe_.InitBuffer(phase_queue_, 1, kTileElements * sizeof(std::uint32_t));
    pipe_.InitBuffer(snr_queue_, 1, kTileElements * sizeof(float));
  }

  __aicore__ inline void Process() {
    const std::uint32_t block = AscendC::GetBlockIdx();
    const std::uint32_t blocks = AscendC::GetBlockNum();
    const std::uint64_t chunk = (task_count_ + static_cast<std::uint64_t>(blocks) - 1) / blocks;
    const std::uint64_t begin = static_cast<std::uint64_t>(block) * chunk;
    const std::uint64_t end = begin + chunk < task_count_ ? begin + chunk : task_count_;
    for (std::uint64_t tile = begin; tile < end; tile += kTileElements) {
      const std::uint64_t remaining = end - tile;
      const std::uint32_t valid = static_cast<std::uint32_t>(remaining < kTileElements ? remaining : kTileElements);
      auto phase_local = phase_queue_.AllocTensor<std::uint32_t>();
      auto snr_local = snr_queue_.AllocTensor<float>();
      for (std::uint32_t k = 0; k < valid; ++k) {
        const std::uint64_t task = tile + k;
        const std::uint32_t trial = static_cast<std::uint32_t>(task % trial_count_);
        const std::uint64_t row_series = task / trial_count_;
        const std::uint32_t shift = static_cast<std::uint32_t>(row_series % rows_eval_);
        const std::uint32_t series = static_cast<std::uint32_t>(row_series / rows_eval_);
        const std::uint32_t width = widths_gm_.GetValue(trial);
        const std::uint64_t profile_base = static_cast<std::uint64_t>(series) * transform_stride_ +
            static_cast<std::uint64_t>(shift) * bins_;
        float profile_sum = 0.0F;
        for (std::uint32_t bin = 0; bin < bins_; ++bin) profile_sum += transform_gm_.GetValue(profile_base + bin);
        float best_sum = -3.402823466e+38F;
        std::uint32_t best_phase = 0;
        for (std::uint32_t phase = 0; phase < bins_; ++phase) {
          float boxcar = 0.0F;
          for (std::uint32_t w = 0; w < width; ++w) {
            const std::uint32_t bin = phase + w < bins_ ? phase + w : phase + w - bins_;
            boxcar += transform_gm_.GetValue(profile_base + bin);
          }
          if (boxcar > best_sum) { best_sum = boxcar; best_phase = phase; }
        }
        const float height = heights_gm_.GetValue(trial);
        const float baseline = baselines_gm_.GetValue(trial);
        phase_local(k) = best_phase;
        snr_local(k) = ((height + baseline) * best_sum - baseline * profile_sum) / stdnoise_;
      }
      phase_queue_.EnQue(phase_local); snr_queue_.EnQue(snr_local);
      auto ready_phase = phase_queue_.DeQue<std::uint32_t>();
      auto ready_snr = snr_queue_.DeQue<float>();
      CopyTailToGlobal(phases_gm_, tile, ready_phase, valid);
      CopyTailToGlobal(snrs_gm_, tile, ready_snr, valid);
      phase_queue_.FreeTensor(ready_phase); snr_queue_.FreeTensor(ready_snr);
    }
  }

 private:
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> phase_queue_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> snr_queue_;
  AscendC::GlobalTensor<float> transform_gm_;
  AscendC::GlobalTensor<std::uint32_t> widths_gm_;
  AscendC::GlobalTensor<float> heights_gm_, baselines_gm_, snrs_gm_;
  AscendC::GlobalTensor<std::uint32_t> phases_gm_;
  std::uint32_t transform_stride_ = 0, rows_eval_ = 0, bins_ = 0;
  std::uint32_t trial_count_ = 0, nseries_ = 0;
  float stdnoise_ = 1.0F;
  std::uint64_t task_count_ = 0;
};
}  // namespace

extern "C" __global__ __aicore__ void gaffa_ffa_copy_level_kernel(
    GM_ADDR input, GM_ADDR scratch, GM_ADDR output,
    std::uint32_t input_stride, std::uint32_t scratch_stride,
    std::uint32_t output_stride, std::uint32_t bins, GM_ADDR metadata,
    std::uint32_t op_count, std::uint32_t nseries, std::uint32_t max_rows) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  FfaCopyLevelKernel kernel;
  kernel.Init(input, scratch, output, input_stride, scratch_stride,
              output_stride, bins, metadata, op_count, nseries, max_rows);
  kernel.Process();
}

extern "C" __global__ __aicore__ void gaffa_ffa_merge_level_kernel(
    GM_ADDR input, GM_ADDR scratch, GM_ADDR output,
    std::uint32_t input_stride, std::uint32_t scratch_stride,
    std::uint32_t output_stride, std::uint32_t bins, GM_ADDR metadata,
    std::uint32_t op_count, std::uint32_t nseries,
    std::uint32_t max_output_rows) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  FfaMergeLevelKernel kernel;
  kernel.Init(input, scratch, output, input_stride, scratch_stride,
              output_stride, bins, metadata, op_count, nseries, max_output_rows);
  kernel.Process();
}

extern "C" void gaffa_launch_ffa_copy_level_ascend(
    void* input, void* scratch, void* output, std::uint32_t input_stride,
    std::uint32_t scratch_stride, std::uint32_t output_stride,
    std::uint32_t bins, void* metadata, std::uint32_t op_count,
    std::uint32_t nseries, std::uint32_t max_rows, std::uint32_t block_dim,
    void* stream) {
  gaffa_ffa_copy_level_kernel<<<block_dim, nullptr, reinterpret_cast<aclrtStream>(stream)>>>(
      static_cast<std::uint8_t*>(input), static_cast<std::uint8_t*>(scratch),
      static_cast<std::uint8_t*>(output), input_stride, scratch_stride,
      output_stride, bins, static_cast<std::uint8_t*>(metadata), op_count,
      nseries, max_rows);
}

extern "C" void gaffa_launch_ffa_merge_level_ascend(
    void* input, void* scratch, void* output, std::uint32_t input_stride,
    std::uint32_t scratch_stride, std::uint32_t output_stride,
    std::uint32_t bins, void* metadata, std::uint32_t op_count,
    std::uint32_t nseries, std::uint32_t max_output_rows,
    std::uint32_t block_dim, void* stream) {
  gaffa_ffa_merge_level_kernel<<<block_dim, nullptr, reinterpret_cast<aclrtStream>(stream)>>>(
      static_cast<std::uint8_t*>(input), static_cast<std::uint8_t*>(scratch),
      static_cast<std::uint8_t*>(output), input_stride, scratch_stride,
      output_stride, bins, static_cast<std::uint8_t*>(metadata), op_count,
      nseries, max_output_rows);
}

extern "C" __global__ __aicore__ void gaffa_ffa_detect_kernel(
    GM_ADDR transform, std::uint32_t transform_stride,
    std::uint32_t rows_eval, std::uint32_t bins, GM_ADDR widths,
    GM_ADDR heights, GM_ADDR baselines, std::uint32_t trial_count,
    float stdnoise, GM_ADDR phases, GM_ADDR snrs, std::uint32_t nseries) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  FfaDetectKernel kernel;
  kernel.Init(transform, transform_stride, rows_eval, bins, widths, heights,
              baselines, trial_count, stdnoise, phases, snrs, nseries);
  kernel.Process();
}

extern "C" void gaffa_launch_ffa_detect_ascend(
    void* transform, std::uint32_t transform_stride, std::uint32_t rows_eval,
    std::uint32_t bins, void* widths, void* heights, void* baselines,
    std::uint32_t trial_count, float stdnoise, void* phases, void* snrs,
    std::uint32_t nseries, std::uint32_t block_dim, void* stream) {
  gaffa_ffa_detect_kernel<<<block_dim, nullptr, reinterpret_cast<aclrtStream>(stream)>>>(
      static_cast<std::uint8_t*>(transform), transform_stride, rows_eval, bins,
      static_cast<std::uint8_t*>(widths), static_cast<std::uint8_t*>(heights),
      static_cast<std::uint8_t*>(baselines), trial_count, stdnoise,
      static_cast<std::uint8_t*>(phases), static_cast<std::uint8_t*>(snrs), nseries);
}
