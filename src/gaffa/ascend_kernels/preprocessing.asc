#include "kernel_operator.h"

#include <acl/acl.h>
#include <cfloat>
#include <cmath>
#include <cstdint>

namespace {
constexpr std::uint32_t kTileElements = 64;
constexpr std::uint32_t kMaxMedianWindow = 256;

template <typename T>
__aicore__ inline void CopyTailToGlobal(
    AscendC::GlobalTensor<T>& dst, std::uint64_t dst_offset,
    const AscendC::LocalTensor<T>& src, std::uint32_t valid_elements) {
  AscendC::DataCopyExtParams params{
      1,
      valid_elements * static_cast<std::uint32_t>(sizeof(T)),
      0,
      0,
      0,
  };
  AscendC::DataCopyPad(dst[dst_offset], src, params);
}

class FiniteCheckKernel {
 public:
  __aicore__ inline void Init(GM_ADDR data, GM_ADDR status,
                              std::uint32_t nseries,
                              std::uint32_t nsamples) {
    nseries_ = nseries;
    nsamples_ = nsamples;
    data_gm_.SetGlobalBuffer((__gm__ float*)data,
                             static_cast<std::uint64_t>(nseries) * nsamples);
    status_gm_.SetGlobalBuffer((__gm__ int32_t*)status, nseries);
    pipe_.InitBuffer(status_queue_, 1, 32);
  }

  __aicore__ inline void Process() {
    const std::uint32_t block = AscendC::GetBlockIdx();
    const std::uint32_t blocks = AscendC::GetBlockNum();
    for (std::uint32_t series = block; series < nseries_; series += blocks) {
      bool invalid = false;
      const std::uint64_t base = static_cast<std::uint64_t>(series) * nsamples_;
      for (std::uint32_t i = 0; i < nsamples_; ++i) {
        const float value = data_gm_.GetValue(base + i);
        if (!(value <= FLT_MAX && value >= -FLT_MAX)) {
          invalid = true;
          break;
        }
      }
      if (invalid) {
        auto local = status_queue_.AllocTensor<int32_t>();
        local(0) = 1;
        status_queue_.EnQue(local);
        auto ready = status_queue_.DeQue<int32_t>();
        CopyTailToGlobal(status_gm_, series, ready, 1);
        status_queue_.FreeTensor(ready);
      }
    }
  }

 private:
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> status_queue_;
  AscendC::GlobalTensor<float> data_gm_;
  AscendC::GlobalTensor<int32_t> status_gm_;
  std::uint32_t nseries_ = 0;
  std::uint32_t nsamples_ = 0;
};

class MeanScrunchKernel {
 public:
  __aicore__ inline void Init(GM_ADDR data, GM_ADDR output,
                              std::uint32_t nseries,
                              std::uint32_t input_nsamples,
                              std::uint32_t output_nsamples,
                              std::uint32_t factor) {
    nseries_ = nseries;
    input_nsamples_ = input_nsamples;
    output_nsamples_ = output_nsamples;
    factor_ = factor;
    input_gm_.SetGlobalBuffer((__gm__ float*)data,
                              static_cast<std::uint64_t>(nseries) * input_nsamples);
    output_gm_.SetGlobalBuffer((__gm__ float*)output,
                               static_cast<std::uint64_t>(nseries) * output_nsamples);
    pipe_.InitBuffer(output_queue_, 1, kTileElements * sizeof(float));
  }

  __aicore__ inline void Process() {
    const std::uint32_t block = AscendC::GetBlockIdx();
    const std::uint32_t blocks = AscendC::GetBlockNum();
    for (std::uint32_t series = block; series < nseries_; series += blocks) {
      const std::uint64_t input_base =
          static_cast<std::uint64_t>(series) * input_nsamples_;
      const std::uint64_t output_base =
          static_cast<std::uint64_t>(series) * output_nsamples_;
      for (std::uint32_t tile = 0; tile < output_nsamples_;
           tile += kTileElements) {
        const std::uint32_t remain = output_nsamples_ - tile;
        const std::uint32_t valid =
            remain < kTileElements ? remain : kTileElements;
        auto local = output_queue_.AllocTensor<float>();
        for (std::uint32_t k = 0; k < valid; ++k) {
          const std::uint32_t output_index = tile + k;
          const std::uint64_t begin =
              input_base + static_cast<std::uint64_t>(output_index) * factor_;
          float sum = 0.0F;
          float compensation = 0.0F;
          for (std::uint32_t j = 0; j < factor_; ++j) {
            const float value = input_gm_.GetValue(begin + j);
            const float corrected = value - compensation;
            const float next = sum + corrected;
            compensation = (next - sum) - corrected;
            sum = next;
          }
          local(k) = sum / static_cast<float>(factor_);
        }
        output_queue_.EnQue(local);
        auto ready = output_queue_.DeQue<float>();
        CopyTailToGlobal(output_gm_, output_base + tile, ready, valid);
        output_queue_.FreeTensor(ready);
      }
    }
  }

 private:
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> output_queue_;
  AscendC::GlobalTensor<float> input_gm_;
  AscendC::GlobalTensor<float> output_gm_;
  std::uint32_t nseries_ = 0;
  std::uint32_t input_nsamples_ = 0;
  std::uint32_t output_nsamples_ = 0;
  std::uint32_t factor_ = 1;
};

class RunningMedianKernel {
 public:
  __aicore__ inline void Init(GM_ADDR input, GM_ADDR baseline,
                              std::uint32_t nseries,
                              std::uint32_t input_nsamples,
                              std::uint32_t output_nsamples,
                              std::uint32_t window_samples) {
    nseries_ = nseries;
    input_nsamples_ = input_nsamples;
    output_nsamples_ = output_nsamples;
    window_samples_ = window_samples;
    input_gm_.SetGlobalBuffer((__gm__ float*)input,
                              static_cast<std::uint64_t>(nseries) * input_nsamples);
    baseline_gm_.SetGlobalBuffer((__gm__ float*)baseline,
                                 static_cast<std::uint64_t>(nseries) * output_nsamples);
    pipe_.InitBuffer(window_buf_, kMaxMedianWindow * sizeof(float));
    pipe_.InitBuffer(output_queue_, 1, kTileElements * sizeof(float));
  }

  __aicore__ inline void Process() {
    const std::uint32_t block = AscendC::GetBlockIdx();
    const std::uint32_t blocks = AscendC::GetBlockNum();
    for (std::uint32_t series = block; series < nseries_; series += blocks) {
      const std::uint64_t input_base =
          static_cast<std::uint64_t>(series) * input_nsamples_;
      const std::uint64_t output_base =
          static_cast<std::uint64_t>(series) * output_nsamples_;
      for (std::uint32_t tile = 0; tile < output_nsamples_;
           tile += kTileElements) {
        const std::uint32_t remain = output_nsamples_ - tile;
        const std::uint32_t valid =
            remain < kTileElements ? remain : kTileElements;
        auto out = output_queue_.AllocTensor<float>();
        auto window = window_buf_.Get<float>();
        for (std::uint32_t k = 0; k < valid; ++k) {
          const std::uint32_t output_index = tile + k;
          const std::int64_t half =
              static_cast<std::int64_t>(window_samples_ / 2);
          for (std::uint32_t j = 0; j < window_samples_; ++j) {
            std::int64_t source = static_cast<std::int64_t>(output_index) +
                                  static_cast<std::int64_t>(j) - half;
            if (source < 0) source = 0;
            if (source >= static_cast<std::int64_t>(input_nsamples_)) {
              source = static_cast<std::int64_t>(input_nsamples_ - 1);
            }
            window(j) = input_gm_.GetValue(
                input_base + static_cast<std::uint64_t>(source));
          }
          for (std::uint32_t j = 1; j < window_samples_; ++j) {
            const float key = window(j);
            std::uint32_t pos = j;
            while (pos > 0 && window(pos - 1) > key) {
              window(pos) = window(pos - 1);
              --pos;
            }
            window(pos) = key;
          }
          out(k) = window(window_samples_ / 2);
        }
        output_queue_.EnQue(out);
        auto ready = output_queue_.DeQue<float>();
        CopyTailToGlobal(baseline_gm_, output_base + tile, ready, valid);
        output_queue_.FreeTensor(ready);
      }
    }
  }

 private:
  AscendC::TPipe pipe_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> window_buf_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> output_queue_;
  AscendC::GlobalTensor<float> input_gm_;
  AscendC::GlobalTensor<float> baseline_gm_;
  std::uint32_t nseries_ = 0;
  std::uint32_t input_nsamples_ = 0;
  std::uint32_t output_nsamples_ = 0;
  std::uint32_t window_samples_ = 0;
};

class InterpolateSubtractKernel {
 public:
  __aicore__ inline void Init(GM_ADDR data, GM_ADDR baseline,
                              std::uint32_t nseries,
                              std::uint32_t nsamples,
                              std::uint32_t baseline_nsamples,
                              std::uint32_t factor) {
    nseries_ = nseries;
    nsamples_ = nsamples;
    baseline_nsamples_ = baseline_nsamples;
    factor_ = factor;
    data_gm_.SetGlobalBuffer((__gm__ float*)data,
                             static_cast<std::uint64_t>(nseries) * nsamples);
    baseline_gm_.SetGlobalBuffer((__gm__ float*)baseline,
                                 static_cast<std::uint64_t>(nseries) * baseline_nsamples);
    pipe_.InitBuffer(output_queue_, 1, kTileElements * sizeof(float));
  }

  __aicore__ inline void Process() {
    const std::uint32_t block = AscendC::GetBlockIdx();
    const std::uint32_t blocks = AscendC::GetBlockNum();
    const float offset = 0.5F * static_cast<float>(factor_ - 1);
    for (std::uint32_t series = block; series < nseries_; series += blocks) {
      const std::uint64_t data_base =
          static_cast<std::uint64_t>(series) * nsamples_;
      const std::uint64_t baseline_base =
          static_cast<std::uint64_t>(series) * baseline_nsamples_;
      for (std::uint32_t tile = 0; tile < nsamples_; tile += kTileElements) {
        const std::uint32_t remain = nsamples_ - tile;
        const std::uint32_t valid =
            remain < kTileElements ? remain : kTileElements;
        auto out = output_queue_.AllocTensor<float>();
        for (std::uint32_t k = 0; k < valid; ++k) {
          const std::uint32_t sample = tile + k;
          const float position =
              (static_cast<float>(sample) - offset) /
              static_cast<float>(factor_);
          float base_value = baseline_gm_.GetValue(baseline_base);
          if (position > 0.0F) {
            const std::uint32_t lower = static_cast<std::uint32_t>(position);
            if (lower >= baseline_nsamples_ - 1) {
              base_value = baseline_gm_.GetValue(
                  baseline_base + baseline_nsamples_ - 1);
            } else {
              const float fraction = position - static_cast<float>(lower);
              const float lo = baseline_gm_.GetValue(baseline_base + lower);
              const float hi = baseline_gm_.GetValue(baseline_base + lower + 1);
              base_value = (1.0F - fraction) * lo + fraction * hi;
            }
          }
          out(k) = data_gm_.GetValue(data_base + sample) - base_value;
        }
        output_queue_.EnQue(out);
        auto ready = output_queue_.DeQue<float>();
        CopyTailToGlobal(data_gm_, data_base + tile, ready, valid);
        output_queue_.FreeTensor(ready);
      }
    }
  }

 private:
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> output_queue_;
  AscendC::GlobalTensor<float> data_gm_;
  AscendC::GlobalTensor<float> baseline_gm_;
  std::uint32_t nseries_ = 0;
  std::uint32_t nsamples_ = 0;
  std::uint32_t baseline_nsamples_ = 0;
  std::uint32_t factor_ = 1;
};

class NormaliseKernel {
 public:
  __aicore__ inline void Init(GM_ADDR data, GM_ADDR status,
                              std::uint32_t nseries,
                              std::uint32_t nsamples,
                              int reject_constant) {
    nseries_ = nseries;
    nsamples_ = nsamples;
    reject_constant_ = reject_constant;
    data_gm_.SetGlobalBuffer((__gm__ float*)data,
                             static_cast<std::uint64_t>(nseries) * nsamples);
    status_gm_.SetGlobalBuffer((__gm__ int32_t*)status, nseries);
    pipe_.InitBuffer(output_queue_, 1, kTileElements * sizeof(float));
    pipe_.InitBuffer(status_queue_, 1, 32);
  }

  __aicore__ inline void Process() {
    const std::uint32_t block = AscendC::GetBlockIdx();
    const std::uint32_t blocks = AscendC::GetBlockNum();
    for (std::uint32_t series = block; series < nseries_; series += blocks) {
      if (status_gm_.GetValue(series) != 0) continue;
      const std::uint64_t base = static_cast<std::uint64_t>(series) * nsamples_;

      float sum = 0.0F;
      float sum_comp = 0.0F;
      float sum_sq = 0.0F;
      float sq_comp = 0.0F;
      for (std::uint32_t i = 0; i < nsamples_; ++i) {
        const float value = data_gm_.GetValue(base + i);
        const float corrected = value - sum_comp;
        const float next = sum + corrected;
        sum_comp = (next - sum) - corrected;
        sum = next;
        const float square = value * value;
        const float corrected_sq = square - sq_comp;
        const float next_sq = sum_sq + corrected_sq;
        sq_comp = (next_sq - sum_sq) - corrected_sq;
        sum_sq = next_sq;
      }
      const float count = static_cast<float>(nsamples_);
      const float mean = sum / count;
      float variance = sum_sq / count - mean * mean;
      if (variance < 0.0F) variance = 0.0F;

      if (!(variance > 0.0F)) {
        if (reject_constant_ != 0) {
          auto status_local = status_queue_.AllocTensor<int32_t>();
          status_local(0) = 2;
          status_queue_.EnQue(status_local);
          auto ready_status = status_queue_.DeQue<int32_t>();
          CopyTailToGlobal(status_gm_, series, ready_status, 1);
          status_queue_.FreeTensor(ready_status);
          continue;
        }
        for (std::uint32_t tile = 0; tile < nsamples_;
             tile += kTileElements) {
          const std::uint32_t remain = nsamples_ - tile;
          const std::uint32_t valid =
              remain < kTileElements ? remain : kTileElements;
          auto out = output_queue_.AllocTensor<float>();
          for (std::uint32_t k = 0; k < valid; ++k) out(k) = 0.0F;
          output_queue_.EnQue(out);
          auto ready = output_queue_.DeQue<float>();
          CopyTailToGlobal(data_gm_, base + tile, ready, valid);
          output_queue_.FreeTensor(ready);
        }
        continue;
      }

      const float inverse_stddev = 1.0F / sqrtf(variance);
      for (std::uint32_t tile = 0; tile < nsamples_;
           tile += kTileElements) {
        const std::uint32_t remain = nsamples_ - tile;
        const std::uint32_t valid =
            remain < kTileElements ? remain : kTileElements;
        auto out = output_queue_.AllocTensor<float>();
        for (std::uint32_t k = 0; k < valid; ++k) {
          out(k) = (data_gm_.GetValue(base + tile + k) - mean) *
                   inverse_stddev;
        }
        output_queue_.EnQue(out);
        auto ready = output_queue_.DeQue<float>();
        CopyTailToGlobal(data_gm_, base + tile, ready, valid);
        output_queue_.FreeTensor(ready);
      }
    }
  }

 private:
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> output_queue_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> status_queue_;
  AscendC::GlobalTensor<float> data_gm_;
  AscendC::GlobalTensor<int32_t> status_gm_;
  std::uint32_t nseries_ = 0;
  std::uint32_t nsamples_ = 0;
  int reject_constant_ = 1;
};
}  // namespace

extern "C" __global__ __aicore__ void gaffa_validate_finite_kernel(
    GM_ADDR data, GM_ADDR status, std::uint32_t nseries,
    std::uint32_t nsamples) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  FiniteCheckKernel kernel;
  kernel.Init(data, status, nseries, nsamples);
  kernel.Process();
}

extern "C" __global__ __aicore__ void gaffa_mean_scrunch_kernel(
    GM_ADDR data, GM_ADDR output, std::uint32_t nseries,
    std::uint32_t input_nsamples, std::uint32_t output_nsamples,
    std::uint32_t factor) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  MeanScrunchKernel kernel;
  kernel.Init(data, output, nseries, input_nsamples, output_nsamples, factor);
  kernel.Process();
}

extern "C" __global__ __aicore__ void gaffa_running_median_kernel(
    GM_ADDR input, GM_ADDR baseline, std::uint32_t nseries,
    std::uint32_t input_nsamples, std::uint32_t output_nsamples,
    std::uint32_t window_samples) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  RunningMedianKernel kernel;
  kernel.Init(input, baseline, nseries, input_nsamples, output_nsamples,
              window_samples);
  kernel.Process();
}

extern "C" __global__ __aicore__ void gaffa_interpolate_subtract_kernel(
    GM_ADDR data, GM_ADDR baseline, std::uint32_t nseries,
    std::uint32_t nsamples, std::uint32_t baseline_nsamples,
    std::uint32_t factor) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  InterpolateSubtractKernel kernel;
  kernel.Init(data, baseline, nseries, nsamples, baseline_nsamples, factor);
  kernel.Process();
}

extern "C" __global__ __aicore__ void gaffa_normalise_kernel(
    GM_ADDR data, GM_ADDR status, std::uint32_t nseries,
    std::uint32_t nsamples, int reject_constant) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  NormaliseKernel kernel;
  kernel.Init(data, status, nseries, nsamples, reject_constant);
  kernel.Process();
}

extern "C" void gaffa_launch_validate_finite_ascend(
    void* data, void* status, std::uint32_t nseries, std::uint32_t nsamples,
    std::uint32_t block_dim, void* stream) {
  gaffa_validate_finite_kernel<<<
      block_dim, nullptr, reinterpret_cast<aclrtStream>(stream)>>>(
      reinterpret_cast<GM_ADDR>(data), reinterpret_cast<GM_ADDR>(status),
      nseries, nsamples);
}

extern "C" void gaffa_launch_mean_scrunch_ascend(
    void* data, void* output, std::uint32_t nseries,
    std::uint32_t input_nsamples, std::uint32_t output_nsamples,
    std::uint32_t factor, std::uint32_t block_dim, void* stream) {
  gaffa_mean_scrunch_kernel<<<
      block_dim, nullptr, reinterpret_cast<aclrtStream>(stream)>>>(
      reinterpret_cast<GM_ADDR>(data), reinterpret_cast<GM_ADDR>(output),
      nseries, input_nsamples, output_nsamples, factor);
}

extern "C" void gaffa_launch_running_median_ascend(
    void* input, void* baseline, std::uint32_t nseries,
    std::uint32_t input_nsamples, std::uint32_t output_nsamples,
    std::uint32_t window_samples, std::uint32_t block_dim, void* stream) {
  gaffa_running_median_kernel<<<
      block_dim, nullptr, reinterpret_cast<aclrtStream>(stream)>>>(
      reinterpret_cast<GM_ADDR>(input), reinterpret_cast<GM_ADDR>(baseline),
      nseries, input_nsamples, output_nsamples, window_samples);
}

extern "C" void gaffa_launch_interpolate_subtract_ascend(
    void* data, void* baseline, std::uint32_t nseries,
    std::uint32_t nsamples, std::uint32_t baseline_nsamples,
    std::uint32_t factor, std::uint32_t block_dim, void* stream) {
  gaffa_interpolate_subtract_kernel<<<
      block_dim, nullptr, reinterpret_cast<aclrtStream>(stream)>>>(
      reinterpret_cast<GM_ADDR>(data), reinterpret_cast<GM_ADDR>(baseline),
      nseries, nsamples, baseline_nsamples, factor);
}

extern "C" void gaffa_launch_normalise_ascend(
    void* data, void* status, std::uint32_t nseries, std::uint32_t nsamples,
    int reject_constant, std::uint32_t block_dim, void* stream) {
  gaffa_normalise_kernel<<<
      block_dim, nullptr, reinterpret_cast<aclrtStream>(stream)>>>(
      reinterpret_cast<GM_ADDR>(data), reinterpret_cast<GM_ADDR>(status),
      nseries, nsamples, reject_constant);
}
