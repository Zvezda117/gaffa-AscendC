#include "kernel_operator.h"

#include <acl/acl.h>
#include <cstdint>

namespace {
constexpr std::uint32_t kTileElements = 64;

template <typename T>
__aicore__ inline void CopyTailToGlobal(
    AscendC::GlobalTensor<T>& dst, std::uint64_t dst_offset,
    const AscendC::LocalTensor<T>& src, std::uint32_t valid_elements) {
  AscendC::DataCopyExtParams params{
      1,
      valid_elements * static_cast<std::uint32_t>(sizeof(T)),
      0,
      0,
      0,
  };
  AscendC::DataCopyPad(dst[dst_offset], src, params);
}

template <typename InT, typename OutT>
class SubbandStage1Kernel {
 public:
  __aicore__ inline void Init(
      GM_ADDR input, GM_ADDR coarse_delays, GM_ADDR subband_begin,
      GM_ADDR subband_end, GM_ADDR intermediate,
      std::uint32_t nominal_dm_count, std::uint32_t input_nsamples,
      std::uint32_t input_nchans, std::uint32_t channel_count,
      std::uint32_t chan_begin, std::uint32_t subband_count,
      std::uint32_t time_begin, std::uint32_t intermediate_nsamples) {
    nominal_dm_count_ = nominal_dm_count;
    input_nsamples_ = input_nsamples;
    input_nchans_ = input_nchans;
    channel_count_ = channel_count;
    chan_begin_ = chan_begin;
    subband_count_ = subband_count;
    time_begin_ = time_begin;
    intermediate_nsamples_ = intermediate_nsamples;
    series_count_ =
        static_cast<std::uint64_t>(nominal_dm_count) * subband_count;

    input_gm_.SetGlobalBuffer(
        (__gm__ InT*)input,
        static_cast<std::uint64_t>(input_nsamples) * input_nchans);
    coarse_gm_.SetGlobalBuffer(
        (__gm__ std::int32_t*)coarse_delays,
        static_cast<std::uint64_t>(nominal_dm_count) * channel_count);
    subband_begin_gm_.SetGlobalBuffer((__gm__ std::uint32_t*)subband_begin,
                                      subband_count);
    subband_end_gm_.SetGlobalBuffer((__gm__ std::uint32_t*)subband_end,
                                    subband_count);
    intermediate_gm_.SetGlobalBuffer(
        (__gm__ OutT*)intermediate,
        series_count_ * intermediate_nsamples);
    pipe_.InitBuffer(output_queue_, 1, kTileElements * sizeof(OutT));
  }

  __aicore__ inline void Process() {
    const std::uint32_t block = AscendC::GetBlockIdx();
    const std::uint32_t blocks = AscendC::GetBlockNum();
    for (std::uint64_t series = block; series < series_count_;
         series += blocks) {
      const std::uint32_t nominal =
          static_cast<std::uint32_t>(series / subband_count_);
      const std::uint32_t subband =
          static_cast<std::uint32_t>(series % subband_count_);
      const std::uint32_t channel_begin =
          subband_begin_gm_.GetValue(subband);
      const std::uint32_t channel_end = subband_end_gm_.GetValue(subband);
      const std::uint64_t delay_base =
          static_cast<std::uint64_t>(nominal) * channel_count_;
      const std::uint64_t output_base = series * intermediate_nsamples_;

      for (std::uint32_t tile = 0; tile < intermediate_nsamples_;
           tile += kTileElements) {
        const std::uint32_t remaining = intermediate_nsamples_ - tile;
        const std::uint32_t valid =
            remaining < kTileElements ? remaining : kTileElements;
        auto local = output_queue_.AllocTensor<OutT>();
        for (std::uint32_t k = 0; k < valid; ++k) {
          const std::uint32_t absolute_time = time_begin_ + tile + k;
          OutT sum = static_cast<OutT>(0);
          for (std::uint32_t c = channel_begin; c < channel_end; ++c) {
            const std::int32_t delay = coarse_gm_.GetValue(delay_base + c);
            const std::uint64_t shifted =
                static_cast<std::uint64_t>(absolute_time) +
                static_cast<std::uint32_t>(delay);
            if (shifted < input_nsamples_) {
              const std::uint64_t input_index =
                  shifted * input_nchans_ + chan_begin_ + c;
              sum += static_cast<OutT>(input_gm_.GetValue(input_index));
            }
          }
          local(k) = sum;
        }
        output_queue_.EnQue(local);
        auto ready = output_queue_.DeQue<OutT>();
        CopyTailToGlobal(intermediate_gm_, output_base + tile, ready, valid);
        output_queue_.FreeTensor(ready);
      }
    }
  }

 private:
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> output_queue_;
  AscendC::GlobalTensor<InT> input_gm_;
  AscendC::GlobalTensor<std::int32_t> coarse_gm_;
  AscendC::GlobalTensor<std::uint32_t> subband_begin_gm_;
  AscendC::GlobalTensor<std::uint32_t> subband_end_gm_;
  AscendC::GlobalTensor<OutT> intermediate_gm_;
  std::uint32_t nominal_dm_count_ = 0;
  std::uint32_t input_nsamples_ = 0;
  std::uint32_t input_nchans_ = 0;
  std::uint32_t channel_count_ = 0;
  std::uint32_t chan_begin_ = 0;
  std::uint32_t subband_count_ = 0;
  std::uint32_t time_begin_ = 0;
  std::uint32_t intermediate_nsamples_ = 0;
  std::uint64_t series_count_ = 0;
};

template <typename OutT>
class SubbandStage2Kernel {
 public:
  __aicore__ inline void Init(
      GM_ADDR intermediate, GM_ADDR residual_delays, GM_ADDR output,
      std::uint32_t ndm, std::uint32_t subband_count,
      std::uint32_t ndm_per_nominal,
      std::uint32_t intermediate_nsamples,
      std::uint32_t output_tile_nsamples,
      std::uint32_t output_total_nsamples,
      std::uint32_t output_time_begin) {
    ndm_ = ndm;
    subband_count_ = subband_count;
    ndm_per_nominal_ = ndm_per_nominal;
    intermediate_nsamples_ = intermediate_nsamples;
    output_tile_nsamples_ = output_tile_nsamples;
    output_total_nsamples_ = output_total_nsamples;
    output_time_begin_ = output_time_begin;
    const std::uint32_t nominal_dm_count =
        (ndm + ndm_per_nominal - 1) / ndm_per_nominal;

    intermediate_gm_.SetGlobalBuffer(
        (__gm__ OutT*)intermediate,
        static_cast<std::uint64_t>(nominal_dm_count) * subband_count *
            intermediate_nsamples);
    residual_gm_.SetGlobalBuffer(
        (__gm__ std::int32_t*)residual_delays,
        static_cast<std::uint64_t>(ndm) * subband_count);
    output_gm_.SetGlobalBuffer(
        (__gm__ OutT*)output,
        static_cast<std::uint64_t>(ndm) * output_total_nsamples);
    pipe_.InitBuffer(output_queue_, 1, kTileElements * sizeof(OutT));
  }

  __aicore__ inline void Process() {
    const std::uint32_t block = AscendC::GetBlockIdx();
    const std::uint32_t blocks = AscendC::GetBlockNum();
    const std::uint64_t inter_series_stride =
        static_cast<std::uint64_t>(subband_count_) * intermediate_nsamples_;

    for (std::uint32_t dm = block; dm < ndm_; dm += blocks) {
      const std::uint32_t nominal = dm / ndm_per_nominal_;
      const std::uint64_t inter_nominal_base =
          static_cast<std::uint64_t>(nominal) * inter_series_stride;
      const std::uint64_t residual_base =
          static_cast<std::uint64_t>(dm) * subband_count_;
      const std::uint64_t output_base =
          static_cast<std::uint64_t>(dm) * output_total_nsamples_ +
          output_time_begin_;

      for (std::uint32_t tile = 0; tile < output_tile_nsamples_;
           tile += kTileElements) {
        const std::uint32_t remaining = output_tile_nsamples_ - tile;
        const std::uint32_t valid =
            remaining < kTileElements ? remaining : kTileElements;
        auto local = output_queue_.AllocTensor<OutT>();
        for (std::uint32_t k = 0; k < valid; ++k) {
          const std::uint32_t local_time = tile + k;
          OutT sum = static_cast<OutT>(0);
          for (std::uint32_t subband = 0; subband < subband_count_;
               ++subband) {
            const std::int32_t delay =
                residual_gm_.GetValue(residual_base + subband);
            const std::uint32_t shifted =
                local_time + static_cast<std::uint32_t>(delay);
            const std::uint64_t intermediate_index =
                inter_nominal_base +
                static_cast<std::uint64_t>(subband) *
                    intermediate_nsamples_ +
                shifted;
            sum += intermediate_gm_.GetValue(intermediate_index);
          }
          local(k) = sum;
        }
        output_queue_.EnQue(local);
        auto ready = output_queue_.DeQue<OutT>();
        CopyTailToGlobal(output_gm_, output_base + tile, ready, valid);
        output_queue_.FreeTensor(ready);
      }
    }
  }

 private:
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECOUT, 1> output_queue_;
  AscendC::GlobalTensor<OutT> intermediate_gm_;
  AscendC::GlobalTensor<std::int32_t> residual_gm_;
  AscendC::GlobalTensor<OutT> output_gm_;
  std::uint32_t ndm_ = 0;
  std::uint32_t subband_count_ = 0;
  std::uint32_t ndm_per_nominal_ = 0;
  std::uint32_t intermediate_nsamples_ = 0;
  std::uint32_t output_tile_nsamples_ = 0;
  std::uint32_t output_total_nsamples_ = 0;
  std::uint32_t output_time_begin_ = 0;
};
}  // namespace

#define DEFINE_STAGE1_KERNEL(kernel_name, InT, OutT) \
extern "C" __global__ __aicore__ void kernel_name( \
    GM_ADDR input, GM_ADDR coarse_delays, GM_ADDR subband_begin, \
    GM_ADDR subband_end, GM_ADDR intermediate, \
    std::uint32_t nominal_dm_count, std::uint32_t input_nsamples, \
    std::uint32_t input_nchans, std::uint32_t channel_count, \
    std::uint32_t chan_begin, std::uint32_t subband_count, \
    std::uint32_t time_begin, std::uint32_t intermediate_nsamples) { \
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY); \
  SubbandStage1Kernel<InT, OutT> kernel; \
  kernel.Init(input, coarse_delays, subband_begin, subband_end, intermediate, \
              nominal_dm_count, input_nsamples, input_nchans, channel_count, \
              chan_begin, subband_count, time_begin, intermediate_nsamples); \
  kernel.Process(); \
}

DEFINE_STAGE1_KERNEL(gaffa_subband_stage1_u8_kernel, std::uint8_t,
                     std::uint32_t)
DEFINE_STAGE1_KERNEL(gaffa_subband_stage1_u16_kernel, std::uint16_t,
                     std::uint32_t)
DEFINE_STAGE1_KERNEL(gaffa_subband_stage1_f32_kernel, float, float)

#define DEFINE_STAGE2_KERNEL(kernel_name, OutT) \
extern "C" __global__ __aicore__ void kernel_name( \
    GM_ADDR intermediate, GM_ADDR residual_delays, GM_ADDR output, \
    std::uint32_t ndm, std::uint32_t subband_count, \
    std::uint32_t ndm_per_nominal, std::uint32_t intermediate_nsamples, \
    std::uint32_t output_tile_nsamples, \
    std::uint32_t output_total_nsamples, \
    std::uint32_t output_time_begin) { \
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY); \
  SubbandStage2Kernel<OutT> kernel; \
  kernel.Init(intermediate, residual_delays, output, ndm, subband_count, \
              ndm_per_nominal, intermediate_nsamples, output_tile_nsamples, \
              output_total_nsamples, output_time_begin); \
  kernel.Process(); \
}

DEFINE_STAGE2_KERNEL(gaffa_subband_stage2_u32_kernel, std::uint32_t)
DEFINE_STAGE2_KERNEL(gaffa_subband_stage2_f32_kernel, float)

#define DEFINE_STAGE1_LAUNCH(launch_name, kernel_name) \
extern "C" void launch_name( \
    void* input, void* coarse_delays, void* subband_begin, void* subband_end, \
    void* intermediate, std::uint32_t nominal_dm_count, \
    std::uint32_t input_nsamples, std::uint32_t input_nchans, \
    std::uint32_t channel_count, std::uint32_t chan_begin, \
    std::uint32_t subband_count, std::uint32_t time_begin, \
    std::uint32_t intermediate_nsamples, std::uint32_t block_dim, \
    void* stream) { \
  kernel_name<<<block_dim, nullptr, reinterpret_cast<aclrtStream>(stream)>>>( \
      reinterpret_cast<GM_ADDR>(input), \
      reinterpret_cast<GM_ADDR>(coarse_delays), \
      reinterpret_cast<GM_ADDR>(subband_begin), \
      reinterpret_cast<GM_ADDR>(subband_end), \
      reinterpret_cast<GM_ADDR>(intermediate), nominal_dm_count, \
      input_nsamples, input_nchans, channel_count, chan_begin, subband_count, \
      time_begin, intermediate_nsamples); \
}

DEFINE_STAGE1_LAUNCH(gaffa_launch_subband_stage1_u8_ascend,
                     gaffa_subband_stage1_u8_kernel)
DEFINE_STAGE1_LAUNCH(gaffa_launch_subband_stage1_u16_ascend,
                     gaffa_subband_stage1_u16_kernel)
DEFINE_STAGE1_LAUNCH(gaffa_launch_subband_stage1_f32_ascend,
                     gaffa_subband_stage1_f32_kernel)

#define DEFINE_STAGE2_LAUNCH(launch_name, kernel_name) \
extern "C" void launch_name( \
    void* intermediate, void* residual_delays, void* output, \
    std::uint32_t ndm, std::uint32_t subband_count, \
    std::uint32_t ndm_per_nominal, std::uint32_t intermediate_nsamples, \
    std::uint32_t output_tile_nsamples, \
    std::uint32_t output_total_nsamples, \
    std::uint32_t output_time_begin, std::uint32_t block_dim, void* stream) { \
  kernel_name<<<block_dim, nullptr, reinterpret_cast<aclrtStream>(stream)>>>( \
      reinterpret_cast<GM_ADDR>(intermediate), \
      reinterpret_cast<GM_ADDR>(residual_delays), \
      reinterpret_cast<GM_ADDR>(output), ndm, subband_count, ndm_per_nominal, \
      intermediate_nsamples, output_tile_nsamples, output_total_nsamples, \
      output_time_begin); \
}

DEFINE_STAGE2_LAUNCH(gaffa_launch_subband_stage2_u32_ascend,
                     gaffa_subband_stage2_u32_kernel)
DEFINE_STAGE2_LAUNCH(gaffa_launch_subband_stage2_f32_ascend,
                     gaffa_subband_stage2_f32_kernel)
